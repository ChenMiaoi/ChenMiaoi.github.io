# Local deployment only; GitHub uses the production environment's variables/secret.
# The client deliberately ignores ~/.ssh/config and never uses root credentials.
DEPLOY_HOST="your-server-ip"
DEPLOY_PORT="22"
DEPLOY_USER="nyachen-deploy"
DEPLOY_KEY_FILE="C:/Users/you/.ssh/nyachen-deploy"
# Obtain the host public key through an already trusted server connection.
DEPLOY_KNOWN_HOSTS="your-server-ip ssh-ed25519 REPLACE_WITH_VERIFIED_HOST_PUBLIC_KEY"
