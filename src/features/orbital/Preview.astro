---
import { render } from "astro:content";
import ArchiveTerminal from "@components/orbital/ArchiveTerminal.svelte";
import { getRawSortedPosts, getSeriesTree, flattenSeriesPosts } from "@utils/content-utils";
import { getPostUrlBySlug } from "@utils/url-utils";
import { contributionConfig, profileConfig } from "../../config";
import { contributionActivity } from "../../lib/contributions/snapshots";
import "../../styles/tailwind.css";
import "../../styles/orbital/index.css";
import "@fontsource-variable/jetbrains-mono";
import "katex/dist/katex.min.css";

const entries = (await getRawSortedPosts()).filter((post) => !post.data.draft);
const seriesTree = await getSeriesTree();
const seriesMap = seriesTree.nodes;
const rendered = await Promise.all(entries.map(async (post) => ({ post, ...await render(post) })));
const plainText = (text: string) => text
  .replace(/!\[[^\]]*\]\([^)]*\)/g, "")
  .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  .replace(/<[^>]+>/g, "")
  .replace(/[`*_#]/g, "")
  .replace(/\s+/g, " ").trim();

const posts = rendered.map(({ post, headings }) => {
  const introduction = (post.body ?? "").split(/\r?\n\s*\r?\n/)
    .find((part) => part.trim() && !/^(#|```|:::|!\[|<|\|)/.test(part.trim())) ?? "";
  const excerpt = plainText(introduction);
  return {
    slug: post.slug,
    title: post.data.title,
    date: post.data.published.toISOString().slice(0, 10).replaceAll("-", "."),
    timestamp: post.data.published.getTime(),
    description: post.data.description || excerpt.match(/^.*?[。！？]/)?.[0] || excerpt,
    excerpt: excerpt || post.data.description,
    category: post.data.category || "",
    series: post.data.series || "",
    seriesTitle: seriesMap.get(post.data.series || "")?.title || "独立文章",
    seriesOrder: post.data.seriesOrder,
    tags: post.data.tags,
    url: getPostUrlBySlug(post.slug, post.data.published),
    contentUrl: `/design-preview/articles/${post.slug}/`,
    headings: headings.map((heading) => ({ ...heading, text: heading.text.replace(/#+$/, "").trim() })),
  };
});
const series = [...seriesTree.nodes.values()].map((entry) => ({
  slug: entry.slug,
  title: entry.title,
  description: entry.description,
  parent: entry.parent || "",
  order: entry.order,
  posts: flattenSeriesPosts(entry).map((post) => post.slug),
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#17191b" />
    <title>Nay's Blog · 轨道档案预览</title>
    <link rel="icon" href="/favicon/favicon-dark-32.png" />
    <link rel="preload" as="image" href="/images/orbital/station.webp" />
  </head>
  <body class="orbital-preview">
    <ArchiveTerminal client:load {posts} {series} projects={contributionConfig.projects} activity={contributionActivity} detailsUrl="/design-preview/contributions.json" profile={profileConfig} />
    <noscript>这个交互预览需要启用 JavaScript。<a href="/">访问博客首页</a></noscript>
  </body>
</html>
