---
import { render } from "astro:content";
import { getRawSortedPosts, type PostEntry } from "../../utils/content-utils";

export async function getStaticPaths() {
  return (await getRawSortedPosts()).filter((post) => !post.data.draft).map((post) => ({
    params: { slug: post.slug }, props: { post },
  }));
}
interface Props { post: PostEntry }
const { Content } = await render(Astro.props.post);
---
<!doctype html>
<html lang="zh-CN">
  <head><meta charset="utf-8" /><meta name="robots" content="noindex, nofollow" /><title>{Astro.props.post.data.title}</title></head>
  <body><article data-reader-content><Content /></article></body>
</html>
