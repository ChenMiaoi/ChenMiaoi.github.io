---
import { contributionConfig } from "../lib/contributions/config";
import { contributionUrl } from "../lib/contributions/navigation";
import ArchiveRedirect from "../features/orbital/ArchiveRedirect.astro";
import Page from "../features/orbital/Page.astro";
import { getRawSortedPosts, getSeriesTree } from "../utils/content-utils";
import { getPostUrlBySlug } from "../utils/url-utils";
import { LOCALES, LOCALE_PREFIX, type Locale } from "../constants/locales";
import { sectionPaths, type Section } from "../lib/content/navigation";

interface Props { lang: Locale; section?: Section; seriesSlug?: string; postSlug?: string; redirectTo?: string; projectId?: string }
export async function getStaticPaths() {
  const paths: { params: { path: string | undefined }; props: Props }[] = [];
  for (const lang of LOCALES) {
    const prefix = LOCALE_PREFIX[lang];
    const add = (url: string, props: Omit<Props, "lang"> = {}) => {
      paths.push({ params: { path: url.replace(/^\/+|\/+$/g, "") || undefined }, props: { lang, ...props } });
    };
    for (const [section, path] of Object.entries(sectionPaths)) add(prefix + path, { section: section as Section });
    for (const project of contributionConfig.projects) add(contributionUrl(project.id, "", "all", prefix), { section: "code", projectId: project.id });
    add(`${prefix}/`);
    add(`${prefix}/archive/`, { redirectTo: prefix + sectionPaths.articles });
    const posts = await getRawSortedPosts(lang);
    for (const post of posts) add(getPostUrlBySlug(post.slug, post.data.published, lang), { postSlug: post.slug });
    for (const series of (await getSeriesTree(lang)).nodes.values()) add(`${prefix}/series/${series.slug}/`, { seriesSlug: series.slug });
    // Existing paginated archive links now lead to the complete Orbital archive.
    for (let page = 2; page <= Math.ceil(posts.length / 8); page++) add(`${prefix}/${page}/`);
  }
  return paths;
}
---
{Astro.props.redirectTo ? <ArchiveRedirect target={Astro.props.redirectTo} lang={Astro.props.lang} /> : <Page {...Astro.props} />}
