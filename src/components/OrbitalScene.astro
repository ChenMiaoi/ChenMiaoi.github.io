---
// Decorative, locally rendered geometry. The static rings remain visible without JavaScript.
---
<orbital-scene aria-hidden="true">
    <div class="orbital-grid"></div>
    <div class="orbital-halo"></div>
    <div class="orbital-reticle orbital-reticle-outer"></div>
    <div class="orbital-reticle orbital-reticle-inner"></div>
    <canvas></canvas>
    <span class="orbit-coordinate coordinate-top">FIG. 001 / INNER SPACE</span>
    <span class="orbit-coordinate coordinate-left">Y +</span>
    <span class="orbit-coordinate coordinate-right">+ X</span>
    <span class="orbit-coordinate coordinate-bottom">SYSTEMS / IDEAS / CONNECTIONS</span>
    <span class="orbital-core">N<span>∞</span></span>
</orbital-scene>

<script>
class OrbitalScene extends HTMLElement {
    private frame = 0;
    private observer?: IntersectionObserver;
    private resize?: ResizeObserver;
    private stop?: () => void;

    connectedCallback() {
        const canvas = this.querySelector("canvas");
        const context = canvas?.getContext("2d");
        if (!canvas || !context) return;
        const motion = matchMedia("(prefers-reduced-motion: reduce)");
        let visible = false;
        let size = 0;
        let rotation = 0;
        let pointer = 0;
        let last = 0;
        const draw = (time = 0) => {
            this.frame = 0;
            if (!size) return;
            const delta = last ? Math.min(time - last, 50) : 0;
            last = time;
            if (!motion.matches) rotation += delta * 0.00006;
            context.clearRect(0, 0, size, size);
            const dark = document.documentElement.classList.contains("dark");
            const scale = size * 0.31;
            const tilt = 0.78 + pointer * 0.12;
            // A torus made of latitude ribbons, projected into perspective.
            for (let ring = 0; ring < 42; ring++) {
                const v = ring / 42 * Math.PI * 2;
                context.beginPath();
                for (let step = 0; step <= 180; step++) {
                    const u = step / 180 * Math.PI * 2;
                    const radius = 1 + 0.34 * Math.cos(v);
                    const x = radius * Math.cos(u);
                    const y = radius * Math.sin(u);
                    const z = 0.34 * Math.sin(v);
                    const tiltedY = y * Math.cos(tilt) - z * Math.sin(tilt);
                    const tiltedZ = y * Math.sin(tilt) + z * Math.cos(tilt);
                    const angle = rotation - 0.6;
                    const px = x * Math.cos(angle) - tiltedY * Math.sin(angle);
                    const py = x * Math.sin(angle) + tiltedY * Math.cos(angle);
                    const perspective = 3.8 / (3.8 - tiltedZ);
                    const sx = size / 2 + px * scale * perspective;
                    const sy = size / 2 + py * scale * perspective;
                    if (step === 0) context.moveTo(sx, sy);
                    else context.lineTo(sx, sy);
                }
                const glow = (Math.sin(v) + 1) / 2;
                context.strokeStyle = dark ? `rgba(${150 + glow * 70}, ${190 + glow * 55}, ${120 + glow * 90}, ${0.12 + glow * 0.5})` : `rgba(57, 88, 34, ${0.1 + glow * 0.5})`;
                context.lineWidth = ring % 7 === 0 ? 1.3 : 0.6;
                context.stroke();
            }
            if (visible && !motion.matches) this.frame = requestAnimationFrame(draw);
        };
        const schedule = () => {
            cancelAnimationFrame(this.frame);
            last = 0;
            this.frame = requestAnimationFrame(draw);
        };
        this.resize = new ResizeObserver(([entry]) => {
            size = entry.contentRect.width;
            const ratio = Math.min(devicePixelRatio || 1, 2);
            canvas.width = size * ratio;
            canvas.height = size * ratio;
            context.setTransform(ratio, 0, 0, ratio, 0, 0);
            schedule();
        });
        this.resize.observe(this);
        this.observer = new IntersectionObserver(([entry]) => {
            visible = entry.isIntersecting && !document.hidden;
            if (visible) schedule();
            else cancelAnimationFrame(this.frame);
        });
        this.observer.observe(this);
        const move = (event: PointerEvent) => {
            pointer = (event.offsetY / Math.max(size, 1) - 0.5) * 2;
        };
        const visibility = () => {
            visible = !document.hidden && this.getBoundingClientRect().bottom > 0;
            if (visible) schedule();
            else cancelAnimationFrame(this.frame);
        };
        const themeObserver = new MutationObserver(schedule);
        themeObserver.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        this.addEventListener("pointermove", move);
        motion.addEventListener("change", schedule);
        document.addEventListener("visibilitychange", visibility);
        this.stop = () => {
            this.removeEventListener("pointermove", move);
            motion.removeEventListener("change", schedule);
            document.removeEventListener("visibilitychange", visibility);
            themeObserver.disconnect();
        };
    }

    disconnectedCallback() {
        cancelAnimationFrame(this.frame);
        this.observer?.disconnect();
        this.resize?.disconnect();
        this.stop?.();
    }
}
if (!customElements.get("orbital-scene")) customElements.define("orbital-scene", OrbitalScene);
</script>
