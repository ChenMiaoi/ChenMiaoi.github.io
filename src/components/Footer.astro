---
import { profileConfig, siteConfig } from "../config";
import { url } from "../utils/url-utils";
interface Props { lang?: string; }
const lang = Astro.props.lang ?? siteConfig.lang;
const year = new Date().getFullYear();
---
<footer class="orbit-footer">
    <div class="footer-signoff">Stay curious<span>↗</span></div>
    <div class="footer-bottom mono">
        <span>© {year} {profileConfig.name} <span class="footer-separator">/</span> A PERSONAL OBSERVATORY</span>
        <div><a href={url(lang === "en" ? "/en/rss.xml" : "/rss.xml")}>RSS ↗</a><a href={url('/sitemap-index.xml')}>SITEMAP ↗</a></div>
    </div>
    <p class="footer-credits mono">BUILT WITH <a href="https://astro.build" target="_blank" rel="noopener noreferrer">ASTRO</a> · BASED ON <a href="https://github.com/saicaca/fuwari" target="_blank" rel="noopener noreferrer">FUWARI</a></p>
</footer>
