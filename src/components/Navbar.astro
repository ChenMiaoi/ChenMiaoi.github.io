---
import { Icon } from "astro-icon/components";
import { LOCALE_NAMES, LOCALES } from "@constants/locales";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import { navBarConfig, siteConfig } from "../config";
import { getLinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { switchLocalePath, url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";
import NavMenuPanel from "./widget/NavMenuPanel.astro";

const className = Astro.props.class;
const lang: string = Astro.props.lang ?? siteConfig.lang;

const presets = getLinkPresets(lang);
let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return presets[item];
		}
		return item;
	},
);

const linkName = (l: NavBarLink) =>
	l.i18nKey ? i18n(l.i18nKey as I18nKey, lang) : l.name;

const currentPath = Astro.url.pathname;
const navigationLinks = links.filter((link) => !link.icon);
const iconLinks = links.filter((link) => link.icon);
---
<div id="navbar" class="z-50 onload-animation">
    <div class:list={[
        className,
        "orbital-navbar !overflow-visible max-w-[var(--page-width)] mx-auto flex items-center justify-between"]}>
        <a href={url('/', lang)} class="orbit-brand" aria-label={siteConfig.title}>
            <span class="brand-mark" aria-hidden="true">N<span>↗</span></span>
            <span class="brand-name">NAY<span class="mono">PERSONAL SPACE</span></span>
        </a>
        <nav aria-label="Main" class="orbit-navigation hidden xl:flex shrink-0">
            {navigationLinks.map((l) => {
                return <a aria-label={linkName(l)} href={l.external ? l.url : url(l.url, lang)} target={l.external ? "_blank" : null}
                          data-nav-link aria-current={currentPath === url(l.url, lang) ? "page" : undefined}
                          class="btn-plain h-11 px-3 whitespace-nowrap"
                >
                    <div class="flex items-center">
                        {linkName(l)}
                        {l.external && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] ml-1 text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </div>
                </a>;
            })}
        </nav>
        <div class="navbar-actions flex shrink-0">
            <!--<SearchPanel client:load>-->
            <Search lang={lang} client:only="svelte"></Search>
            <button aria-label="Language" name="Language Switch" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="locale-switch">
                <Icon name="material-symbols:language" class="text-[1.25rem]"></Icon>
            </button>
            {!siteConfig.themeColor.fixed && (
                    <button aria-label="Display Settings" class="btn-plain scale-animation rounded-lg h-11 w-11 active:scale-90" id="display-settings-switch">
                        <Icon name="material-symbols:palette-outline" class="text-[1.25rem]"></Icon>
                    </button>
            )}
            <LightDarkSwitch lang={lang} client:only="svelte"></LightDarkSwitch>
            {iconLinks.map((link) => <a
                href={link.external ? link.url : url(link.url, lang)}
                aria-label={linkName(link)} title={linkName(link)}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noopener noreferrer" : undefined}
                class="navbar-icon-link btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90"
            >
                <Icon name={link.icon!} class="text-[1.25rem]" />
            </a>)}
            <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 xl:!hidden" id="nav-menu-switch">
                <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
            </button>
        </div>
        <NavMenuPanel links={navigationLinks} lang={lang}></NavMenuPanel>
        <DisplaySettings lang={lang} client:only="svelte"></DisplaySettings>
        <div id="locale-panel" class:list={["float-panel float-panel-closed absolute transition-all fixed right-4 px-2 py-2"]}>
            <!-- Locale switches reload the navbar, document language and title. -->
            {LOCALES.map((l) => (
                <a href={switchLocalePath(currentPath, l)} data-locale={l} data-no-swup
                   class="group flex justify-between items-center py-2 pl-3 pr-4 rounded-lg gap-8
                    hover:bg-[var(--btn-plain-bg-hover)] active:bg-[var(--btn-plain-bg-active)] transition"
                >
                    <div class:list={["transition font-bold group-hover:text-[var(--primary)]",
                        l === lang ? "text-[var(--primary)]" : "text-black/75 dark:text-white/75"]}>
                        {LOCALE_NAMES[l]}
                    </div>
                </a>
            ))}
        </div>
    </div>
</div>

<style>
    .navbar-icon-link:focus-visible {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
    @media (max-width: 639px) {
        .navbar-actions > :global(button),
        .navbar-actions > a,
        .navbar-actions :global(#scheme-switch) {
            width: 36px;
            height: 44px;
        }
    }
    @media (max-width: 359px) {
        .navbar-actions > :global(button),
        .navbar-actions > a,
        .navbar-actions :global(#scheme-switch) {
            width: 32px;
        }
    }
</style>

<script>
import { switchLocalePath } from "../utils/url-utils";
import { onSwupReady } from "../scripts/lifecycle";
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function updateLocaleLinks() {
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]").forEach((link) => {
        const active = new URL(link.href).pathname === window.location.pathname;
        if (active) link.setAttribute("aria-current", "page");
        else link.removeAttribute("aria-current");
    });
    document
        .querySelectorAll<HTMLAnchorElement>("#locale-panel a[data-locale]")
        .forEach((a) => {
            const l = a.dataset.locale;
            if (l) a.href = switchLocalePath(window.location.pathname, l);
        });
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            let menuPanel = document.getElementById("nav-menu-panel");
            if (menuPanel) {
                menuPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    const menuPanel = document.getElementById("nav-menu-panel");
    menuPanel?.addEventListener("click", (event) => {
        if (event.target instanceof Element && event.target.closest("a")) {
            menuPanel.classList.add("float-panel-closed");
        }
    });

    let localeBtn = document.getElementById("locale-switch");
    if (localeBtn) {
        localeBtn.onclick = function () {
            let localePanel = document.getElementById("locale-panel");
            if (localePanel) {
                localePanel.classList.toggle("float-panel-closed");
            }
        };
    }
}

loadButtonScript();
updateLocaleLinks();

onSwupReady((swup) => swup.hooks.on("page:view", updateLocaleLinks));
</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}
