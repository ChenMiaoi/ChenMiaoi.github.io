---
import { type CollectionEntry, render } from "astro:content";
import path from "node:path";
import { Icon } from "astro-icon/components";
import { siteConfig } from "../config";
import I18nKey from "../i18n/i18nKey";
import { i18n } from "../i18n/translation";
import { observatoryCopy } from "@i18n/observatory";
import { getDir, getTagUrl, getCategoryUrl } from "../utils/url-utils";
import { formatDisplayDate } from "@utils/date-utils";
import ImageWrapper from "./misc/ImageWrapper.astro";
interface Props {
    class?: string; entry: CollectionEntry<"posts">; title: string; url: string;
    published: Date; updated?: Date; tags: string[]; category: string | null;
    image: string; description: string; draft: boolean; style: string; lang?: string;
}
const { entry, title, url, published, tags, category, image, description, style, draft } = Astro.props;
const lang = Astro.props.lang ?? siteConfig.lang;
const t = observatoryCopy(lang);
const { remarkPluginFrontmatter } = await render(entry);
---
<article class:list={["note-card", Astro.props.class]} style={style} data-post-path={url}>
    <div class="note-meta mono">
        <time datetime={published.toISOString()}>{formatDisplayDate(published)}</time>
        {category && <a href={getCategoryUrl(category, lang)}>{category}</a>}
        {draft && <span>DRAFT</span>}
        <span class="note-corner" aria-hidden="true">↗</span>
    </div>
    {image && <a href={url} class="note-cover" aria-label={title}><ImageWrapper src={image} basePath={path.join("content/posts/", getDir(entry.id))} alt={title} class="w-full h-full" /></a>}
    <h3><a href={url}>{title}</a></h3>
    <p class="note-description">{description || remarkPluginFrontmatter.excerpt}</p>
    <div class="note-tags">{tags.slice(0, 3).map(tag => <a href={getTagUrl(tag, lang)}>#{tag}</a>)}</div>
    <div class="note-bottom">
        <span class="note-reading mono">{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount, lang)}<span class="note-views" title={i18n(I18nKey.views, lang)}><Icon name="material-symbols:visibility-outline-rounded" /><span data-count="views">—</span></span><span class="note-views" title={i18n(I18nKey.likes, lang)}><Icon name="material-symbols:favorite-outline-rounded" /><span data-count="likes">—</span></span></span>
        <a href={url} class="note-read" aria-label={t.read + ": " + title}>{t.read}<span aria-hidden="true"> ↗</span></a>
    </div>
</article>
