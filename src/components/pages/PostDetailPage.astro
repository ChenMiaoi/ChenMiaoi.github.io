---
import path from "node:path";
import type { CollectionEntry } from "astro:content";
import License from "@components/misc/License.astro";
import Markdown from "@components/misc/Markdown.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import SeriesNav from "@components/SeriesNav.astro";
import Comment from "@components/Comment.astro";
import { getCategoryUrl, getDir, getPostUrlBySlug, getTagUrl, url } from "@utils/url-utils";
import type { SeriesNavData } from "@utils/content-utils";
import { Icon } from "astro-icon/components";
import { licenseConfig } from "src/config";
import ImageWrapper from "@components/misc/ImageWrapper.astro";
import { formatDateToYYYYMMDD, formatDisplayDate, formatDateTime } from "@utils/date-utils";
import { profileConfig, siteConfig } from "src/config";

interface Props {
	entry: CollectionEntry<"posts">;
	seriesNav: SeriesNavData | null;
	lang?: string;
}

const { entry, seriesNav, lang } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await entry.render();

// Append a "Comments" entry to the TOC so readers of long posts can jump
// straight to the comment section. Its depth must equal the post's own
// minimum heading depth — TOC.astro recomputes minDepth from this list,
// and a smaller value would shift the level filter and hide real headings.
const minHeadingDepth = headings.length
	? Math.min(...headings.map((h) => h.depth))
	: 1;
const tocHeadings = siteConfig.comment.enable
	? [
			...headings,
			{
				depth: minHeadingDepth,
				slug: "comments",
				text: i18n(I18nKey.comments, lang),
			},
		]
	: headings;

const nextPostUrl =
	entry.data.nextSlug && entry.data.nextPublished
		? getPostUrlBySlug(entry.data.nextSlug, entry.data.nextPublished, lang)
		: "";
const prevPostUrl =
	entry.data.prevSlug && entry.data.prevPublished
		? getPostUrlBySlug(entry.data.prevSlug, entry.data.prevPublished, lang)
		: "";

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: entry.data.title,
	description: entry.data.description || entry.data.title,
	keywords: entry.data.tags,
	author: {
		"@type": "Person",
		name: profileConfig.name,
		url: Astro.site,
	},
	datePublished: formatDateToYYYYMMDD(entry.data.published),
	inLanguage: lang
		? lang.replace("_", "-")
		: siteConfig.lang.replace("_", "-"),
	// TODO include cover image here
};
const showSeriesSidebar = !!seriesNav && seriesNav.items.length > 1;
const sidebar = showSeriesSidebar ? "series" : "none";
const description = entry.data.description.trim();
---
<MainGridLayout sidebar={sidebar} seriesSidebar={seriesNav} banner={entry.data.image} title={entry.data.title} description={entry.data.description} lang={lang} setOGTypeArticle={true} headings={tocHeadings}>
    <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)}></script>
    <div class="post-reading-column">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <article id="post-container" aria-labelledby="post-title" class="card-base z-10 px-6 md:px-9 pt-6 pb-4 relative w-full">
            <header class="post-header onload-animation">
                <h1 id="post-title" data-pagefind-body data-pagefind-weight="10" data-pagefind-meta="title" class="text-90">
                    {entry.data.title}
                </h1>
                {description && <p class="post-description text-75">{description}</p>}
                <div class="post-details text-75">
                    <time datetime={entry.data.published.toISOString()} title={formatDateTime(entry.data.published)}>
                        {i18n(I18nKey.publishedAt, lang)} {formatDisplayDate(entry.data.published)}
                    </time>
                    {entry.data.updated && entry.data.updated.getTime() !== entry.data.published.getTime() && <time datetime={entry.data.updated.toISOString()} title={formatDateTime(entry.data.updated)}>
                        {i18n(I18nKey.updatedAt, lang)} {formatDisplayDate(entry.data.updated)}
                    </time>}
                    <span>{remarkPluginFrontmatter.minutes} {i18n(remarkPluginFrontmatter.minutes === 1 ? I18nKey.minuteCount : I18nKey.minutesCount, lang)}</span>
                    <span>{remarkPluginFrontmatter.words} {i18n(I18nKey.wordsCount, lang)}</span>
                </div>
                <div class="post-taxonomy text-75">
                    {entry.data.category && <a href={getCategoryUrl(entry.data.category, lang)} aria-label={`${i18n(I18nKey.categories, lang)}: ${entry.data.category}`}>{entry.data.category}</a>}
                    {entry.data.tags.map((tag) => <a href={getTagUrl(tag, lang)} aria-label={`${i18n(I18nKey.tags, lang)}: ${tag}`}>#{tag}</a>)}
                </div>
                {seriesNav && <div class:list={["post-series-context", {"lg:hidden": showSeriesSidebar}]}>
                    <span>{i18n(I18nKey.series, lang)}</span>
                    <a href={url(`/series/${seriesNav.leafSlug}/`, lang)}>{seriesNav.leafTitle}</a>
                </div>}
            </header>

            <!-- always show cover as long as it has one -->

            {entry.data.image &&
                <ImageWrapper id="post-cover" src={entry.data.image} basePath={path.join("content/posts/", getDir(entry.id))} class="mb-8 rounded-xl banner-container onload-animation"/>
            }


            <Markdown class="mb-6 markdown-content onload-animation">
                <Content />
            </Markdown>

            {seriesNav && (seriesNav.prev || seriesNav.next) && <SeriesNav {...seriesNav} lang={lang} />}

            {licenseConfig.enable && <License title={entry.data.title} slug={entry.slug} pubDate={entry.data.published} lang={lang} class="mb-6 rounded-xl license-container onload-animation"></License>}

        </article>
    </div>

    {siteConfig.comment.enable && <Comment lang={lang} />}

    <div class="flex flex-col md:flex-row justify-between mb-4 gap-4 overflow-hidden w-full">
        <a href={nextPostUrl || "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !nextPostUrl}]}>
            {nextPostUrl && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-start gap-4" >
                <Icon name="material-symbols:chevron-left-rounded" class="text-[2rem] text-[var(--primary)]" />
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.nextTitle}
                </div>
            </div>}
        </a>

        <a href={prevPostUrl || "#"}
           class:list={["w-full font-bold overflow-hidden active:scale-95", {"pointer-events-none": !prevPostUrl}]}>
            {prevPostUrl && <div class="btn-card rounded-2xl w-full h-[3.75rem] max-w-full px-4 flex items-center !justify-end gap-4">
                <div class="overflow-hidden transition overflow-ellipsis whitespace-nowrap max-w-[calc(100%_-_3rem)] text-black/75 dark:text-white/75">
                    {entry.data.prevTitle}
                </div>
                <Icon name="material-symbols:chevron-right-rounded" class="text-[2rem] text-[var(--primary)]" />
            </div>}
        </a>
    </div>
    </div>

</MainGridLayout>

<style>
    .post-reading-column { width: 100%; max-width: 52rem; margin-inline: auto; }
    .post-header { border-bottom: 1px solid var(--line-divider); margin-bottom: 24px; padding-bottom: 20px; }
    #post-title { font-size: 28px; font-weight: 700; line-height: 1.35; margin: 0; overflow-wrap: anywhere; }
    .post-description { font-size: 16px; line-height: 1.8; margin: 16px 0 0; }
    .post-details, .post-taxonomy { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 16px; }
    .post-details { font-size: 14px; line-height: 1.6; margin-top: 16px; }
    .post-taxonomy { font-size: 13px; line-height: 1.7; margin-top: 8px; }
    .post-taxonomy a:hover { color: var(--btn-content); }
    .post-series-context { font-size: 14px; line-height: 1.7; margin-top: 12px; }
    .post-series-context span { color: var(--btn-content); margin-right: 8px; }
    .post-series-context a { color: var(--btn-content); text-decoration: underline; text-underline-offset: 3px; }
    .post-header a:focus-visible { outline: 2px solid var(--primary); outline-offset: 3px; }
    .post-reading-column :global(.markdown-content) { font-size: 16px; line-height: 1.8; }
    .post-reading-column :global(.markdown-content h2) { font-size: 24px; line-height: 1.4; }
    .post-reading-column :global(.markdown-content h3) { font-size: 20px; line-height: 1.5; }
    .post-reading-column :global(.markdown-content h4) { font-size: 18px; line-height: 1.5; }
    @media (min-width: 768px) { #post-title { font-size: 36px; } }
</style>
