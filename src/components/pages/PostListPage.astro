---
import type { Page } from "astro";
import Pagination from "@components/control/Pagination.astro";
import PostPage from "@components/PostPage.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import ObservatoryHero from "@components/ObservatoryHero.astro";
import { getSeriesTree, flattenSeriesPosts } from "@utils/content-utils";
import { url } from "@utils/url-utils";
import { observatoryCopy } from "@i18n/observatory";

interface Props {
	page: Page;
	lang?: string;
}

const { page, lang } = Astro.props;

const len = page.data.length;
const NotesHeading = page.currentPage === 1 ? "h2" : "h1";
const t = observatoryCopy(lang);
const tree = await getSeriesTree(lang);
const series = tree.roots.map(node => ({ node, count: flattenSeriesPosts(node).length })).sort((a, b) => b.count - a.count);
---

<MainGridLayout lang={lang} sidebar="none">
    {page.currentPage === 1 && <ObservatoryHero lang={lang} total={page.total} collections={tree.roots.length} />}
    <section id="latest" class="notes-section" aria-labelledby="latest-title">
    <div class="section-heading">
        <div><p class="mono section-kicker">01 / FIELD NOTES</p><NotesHeading id="latest-title">{t.latest}<span class="section-dot">.</span></NotesHeading></div>
        <a class="orbit-text-link" href={url('/archive/', lang)}>{t.all} <span aria-hidden="true">↗</span></a>
    </div>
    {len > 0 ? <PostPage page={page} lang={lang} /> : <div class="empty-notes"><p>{t.empty}</p>{lang === 'en' && <a class="orbit-text-link" href={url('/')} data-no-swup>{t.chinese} ↗</a>}</div>}
    {page.lastPage > 1 && <Pagination class="mx-auto onload-animation" page={page} lang={lang} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`} />}
    </section>
    {page.currentPage === 1 && <section class="paths-section" aria-labelledby="paths-title">
        <div class="section-heading"><div><p class="mono section-kicker">02 / EXPLORATION PATHS</p><h2 id="paths-title">{t.paths}<span class="section-dot">.</span></h2></div><p class="paths-description">{t.pathsDescription}</p></div>
        <div class="orbit-paths">{series.slice(0, 3).map(({ node, count }, index) => <a href={url(`/series/${node.slug}/`, lang)} class="orbit-path">
            <div class="path-top mono"><span>PATH / {String(index + 1).padStart(2, '0')}</span><span aria-hidden="true">↗</span></div>
            <div class:list={['path-symbol', `path-symbol-${index}`]} aria-hidden="true"><span></span><span></span><span></span></div>
            <h3>{node.title}</h3><p>{node.description}</p><span class="mono path-count">{String(count).padStart(2, '0')} {t.articles}</span>
        </a>)}</div>
    </section>}
</MainGridLayout>
