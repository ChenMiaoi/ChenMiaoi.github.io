---
interface Props { title: string; index: string; label: string; }
const { title, index, label } = Astro.props;
---
<header class="orbit-page-heading"><div><p class="mono section-kicker">{index} / {label}</p><h1>{title}<span class="section-dot">.</span></h1></div><span class="page-heading-mark" aria-hidden="true">✳</span></header>
